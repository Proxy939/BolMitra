<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon.

    `mipmap-anydpi-v26` alone is sufficient here and there are deliberately NO legacy PNG mipmaps:
    adaptive icons landed in API 26 and this app's `minSdk` is 28, so every device that can install
    BolMitra gets this file. Shipping density-bucketed PNGs as well would add bytes that nothing can
    ever load.

    `monochrome` supplies the Android 13+ themed-icon variant, so the launcher can tint the mark to
    the user's wallpaper palette instead of falling back to a shrunken screenshot of the full-colour
    one.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_bolmitra_emblem" />
    <monochrome android:drawable="@drawable/ic_bolmitra_emblem_mono" />
</adaptive-icon>
