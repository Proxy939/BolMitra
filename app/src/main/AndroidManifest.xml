<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The teacher speaks Hindi into the tablet, so this is the one permission the product
      actually needs. Declaring it is necessary but NOT sufficient: RECORD_AUDIO is a
      dangerous-level permission, so on API 23+ it must also be requested at runtime. See
      MainActivity.

      No FOREGROUND_SERVICE / FOREGROUND_SERVICE_MICROPHONE, and no <service>. The LivePane
      warning banner claimed a microphone foreground service was "mandatory from API 34" —
      that is true for recording that continues while the app is in the background, which is
      not what this does. Capture here is push-to-talk with the Activity visible and stops on
      release, so no service is required. Adding one would mean a notification, a new
      lifecycle to get wrong, and API 34's background-start restrictions, for nothing.

      Deliberately absent: CAMERA. Nothing in this app opens a camera. Requesting an unused
      dangerous permission in an app used by children, which promises that nothing they say
      leaves the tablet, is a privacy claim we would be unable to back up. If a camera feature
      is coming (worksheet scanning, for instance) it should land with the code that uses it.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Declared as not-required so the app still installs on a tablet with no mic; the UI
      already has to handle capture being unavailable.
    -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!--
      ARCHITECTURE.md §6.9.4 / V52: allowBackup defaults to TRUE and Auto Backup would
      upload app data to Google Drive. The privacy invariant says student records never
      leave the device, so this must be explicitly false.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BolMitra">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BolMitra">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
